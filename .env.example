# Aegis configuration — copy to `.env` and fill in.
#
#   cp .env.example .env
#
# Every variable here is optional. With NO .env at all, Aegis falls back
# to the 'fake' provider and runs offline for free. That is deliberate:
# a fresh clone should run before it asks you for a credit card.

# ---------------------------------------------------------------------------
# Provider
# ---------------------------------------------------------------------------
# YOU DO NOT HAVE TO EDIT THIS FILE TO USE A CLOUD MODEL.
#
# The sidebar's Connection panel takes an API key at runtime and remembers it
# in ~/.aegis/keys.json (mode 0600, outside the repo so it cannot be
# committed by accident). This file is the alternative for anyone who would
# rather keep credentials in the environment — and the environment always
# wins over a saved key, so exporting one is how you override the other.
#
# Providers, all speaking the OpenAI chat-completions dialect:
#
#   ollama      local, free forever, no key            (see below)
#   fake        no model at all, for testing routing
#   groq        FREE TIER, no card, very fast
#   cerebras    FREE TIER, no card, fastest of the lot
#   zai         FREE: glm-4.5-flash costs nothing
#   google      FREE TIER, no card (Gemini)
#   mistral     FREE TIER after phone verification
#   openrouter  FREE: any model id ending ':free'
#   together    FREE: any model id ending '-Free'
#   nvidia      1000 free credits on signup
#   sambanova   free developer tier
#   moonshot    Kimi K2 — trial credit on new accounts
#   deepseek    paid, but among the cheapest serious models
#   openai      paid
#   custom      anything else that speaks the dialect (vLLM, LM Studio, ...)
#
# Leave blank to auto-detect from whichever API key is present in the
# ENVIRONMENT. Saved keys are deliberately NOT consulted here: selecting a
# provider is a choice, and remembering its key is not the same choice.
AEGIS_PROVIDER=ollama

# ---------------------------------------------------------------------------
# Keys — set only the one matching your provider
# ---------------------------------------------------------------------------
# Free tiers, no card required.
# https://console.groq.com/keys
GROQ_API_KEY=
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# https://build.nvidia.com
NVIDIA_API_KEY=
# https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=

# Free model ids available, account still required.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=

# Trial credit, then paid.
# https://platform.moonshot.ai/console/api-keys
MOONSHOT_API_KEY=

# Paid.
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# For AEGIS_PROVIDER=custom, point at any OpenAI-compatible endpoint.
# AEGIS_BASE_URL=http://localhost:8000/v1
# AEGIS_CUSTOM_API_KEY=

# Ollama ignores the value but the OpenAI SDK requires something non-empty.
OLLAMA_API_KEY=ollama

# Where runtime-saved keys live. Default: ~/.aegis/keys.json
# AEGIS_KEYSTORE=

# ---------------------------------------------------------------------------
# Critic strictness
# ---------------------------------------------------------------------------
# calibrated  (default) the tuned prompt. Measured at 100% balanced accuracy
#             on the eight-case set: passes good answers, catches invented
#             statistics, false mechanisms and non-answers. Biased toward
#             APPROVE on purpose — a critic that approves nothing makes every
#             debate hit the round cap and marks every answer contested.
# adversarial raises the bar: unstated load-bearing assumptions and
#             underivable numbers become defects, and the Critic must state
#             the strongest counter-argument before it may approve. Longer
#             debates, and NOT free. Measure it before trusting it:
#               ./dev.sh calibrate --strictness adversarial
AEGIS_CRITIC_STRICTNESS=calibrated

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# Two different models on purpose: the Proposer generates, the Critic judges.
# Using the same model for both means it tends to approve its own reasoning
# style — a real and well-documented weakness of self-critique. Different
# model families disagree more usefully.
# For OpenRouter (remote):
#   AEGIS_PROPOSER_MODEL=qwen/qwen-2.5-72b-instruct
#   AEGIS_CRITIC_MODEL=deepseek/deepseek-chat
#
# For a local Ollama on a 4GB GPU, both roles share ONE model. That looks
# like it contradicts the paragraph above, and on better hardware it would.
# The constraint is arithmetic: gemma2:2b occupies 1.9GB fully GPU-resident,
# so a second distinct model cannot also fit, and two models that do not fit
# together get evicted and reloaded on EVERY turn - 7-12s of pure overhead
# per turn, on a system where a whole turn takes 6s.
#
# So on 4GB the cross-model critique is not "better but pricier", it is
# unaffordable. Run one model, keep the weakness in view, and revisit if you
# ever get more VRAM (or pull a second model small enough to co-reside -
# roughly 1.8GB or less alongside gemma2:2b).
AEGIS_PROPOSER_MODEL=gemma2:2b
AEGIS_CRITIC_MODEL=gemma2:2b

# ALTERNATIVE, measured: gemma2:2b proposes, qwen3.5:4b judges.
#
#   AEGIS_CRITIC_MODEL=qwen3.5:4b
#
# gemma2:2b cannot be made into a working critic by prompt engineering - four
# revisions moved it between "approves nothing" and "approves everything" and
# never found a middle (run `./dev.sh calibrate` to see it). On the identical
# prompt, qwen3.5:4b approves a strong answer that gemma2:2b rejects 5/5.
#
# The price is steep and worth stating plainly. qwen3.5:4b needs 3.7GB, so on
# a 4GB card 40% of it runs on the CPU at ~9 tok/s, and it thinks for ~2450
# tokens before answering: roughly 260s per critic turn. Mixing the two models
# also means neither stays resident, adding a reload per turn - though that is
# noise next to 260s. A 3-round debate becomes 20+ minutes.
#
# Use it when you care whether the verdict means anything. Use gemma2:2b for
# both when you are debugging the machinery, where a fast wrong verdict is
# fine because you are watching the routing, not the judgement.

# The Arbiter breaks deadlocks. Blank = reuse the critic model.
# This is the one place a stronger, pricier model is cheap: it runs at
# most once per debate, and only on questions that actually deadlocked -
# i.e. exactly the hard ones where extra reasoning is worth paying for.
AEGIS_ARBITER_MODEL=

# Set to 0 to disable escalation. On deadlock you then get the last
# unreviewed revision instead of a ruling - the weakest output this
# system can produce. Only turn this off to save money deliberately.
AEGIS_USE_ARBITER=1

# ---------------------------------------------------------------------------
# Safety limits
# ---------------------------------------------------------------------------
# Hard iteration cap. Failure mode #1 is Proposer and Critic disagreeing
# forever. 3 is a good default; above 5 you get diminishing returns.
AEGIS_MAX_ROUNDS=3

# Budget guard per run, in USD (estimated). 0 disables.
# Independent of the round cap, because one long-context round can cost
# more than five short ones.
AEGIS_MAX_COST_USD=0.50

# WALL-CLOCK GUARD, in seconds. 0 disables.
#
# This is the guard that actually protects a LOCAL run. Local tokens are
# free, so max_cost_usd above can never fire - a stuck loop would occupy
# your only GPU indefinitely without spending a cent. A guard denominated
# in a currency the run does not spend is not a guard, so bound the
# resource local inference really consumes: time.
AEGIS_MAX_SECONDS=600

# Tokens per turn. At the ~50 tok/s this hardware sustains, 500 tokens is
# ~10s of generation, and a 3-round debate is 7 calls. Mostly a latency dial.
AEGIS_MAX_TOKENS=500

# Ollama KV-cache window. On a 4GB card this is a VRAM dial: context
# allocation is part of what decides whether the model stays fully
# GPU-resident or spills to the CPU and runs ~3x slower.
AEGIS_NUM_CTX=4096

# ---------------------------------------------------------------------------
# Reasoning ("thinking") models
# ---------------------------------------------------------------------------
# Some models reason before answering, and that reasoning is billed against
# the SAME token budget as the reply while never appearing in it. Detected
# from Ollama's own capability list, not guessed from the name - qwen3.5:4b
# does not say "reasoning" anywhere.
#
# The failure mode is nasty precisely because it is quiet: with a budget
# tuned for a plain model, a thinking model spends the lot on thought and
# returns an EMPTY string while reporting hundreds of generated tokens. The
# empty answer then flows into the Critic, which cannot approve it, so the
# debate runs the full round cap and reports a confident "contested" result
# about nothing at all. Aegis now raises EmptyCompletionError instead.
#
# Measured on qwen3.5:4b: 2453 output tokens and 10.6k characters of thought
# to answer one critic prompt that gemma2:2b answers in ~200 tokens.
AEGIS_REASONING_MAX_TOKENS=4096

# Context window for those models. Must hold the prompt PLUS everything
# generated, thinking included - so it cannot equal the token budget.
AEGIS_REASONING_NUM_CTX=8192

# Stream tokens as they generate (1) or wait for whole turns (0).
AEGIS_STREAM=1

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
AEGIS_TRANSCRIPT_DIR=runs

# If you point AEGIS_BASE_URL at a remote GPU tunnel (vLLM behind ngrok,
# per the strategy report's hybrid architecture), it overrides the
# provider's default URL. Nothing else needs to change.
# AEGIS_BASE_URL=https://xxxx.ngrok-free.app/v1
